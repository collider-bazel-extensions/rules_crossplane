"""Maintainer-only render flow."""

load("@rules_helm//:defs.bzl", "helm_template")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# ---- 2.2.1 ------------------------------------------------------------------

helm_template(
    name = "render_crossplane_2_2_1",
    chart = ["@crossplane_chart_2_2_1//:files"],
    values = ["//config:crossplane-values.yaml"],
    namespace = "crossplane-system",
    release_name = "crossplane",
)

sh_binary(
    name = "render_writeback_2_2_1",
    srcs = ["writeback.sh"],
    data = [":render_crossplane_2_2_1"],
    args = [
        "$(rootpath :render_crossplane_2_2_1)",
        "private/manifests/crossplane.yaml",
    ],
    visibility = ["//visibility:public"],
)
