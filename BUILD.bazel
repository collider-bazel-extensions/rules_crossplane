load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
    "WORKSPACE",
    "defs.bzl",
])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "@rules_kubectl//:defs",
    ],
)

# Toolchain type for the `crank` CLI (used by crossplane_render_test).
toolchain_type(name = "crank_toolchain_type")
