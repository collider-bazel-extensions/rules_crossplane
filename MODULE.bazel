"""rules_crossplane — hermetic Crossplane (crank render + controller) for Bazel."""

module(
    name = "rules_crossplane",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "rules_kubectl", version = "0.2.0")
git_override(
    module_name = "rules_kubectl",
    remote = "https://github.com/collider-bazel-extensions/rules_kubectl",
    commit = "81b60ab80df46b64c612f2576ffef0a7af98ccb6",  # v0.2.0
)

# Primitive 1: `crank` binary toolchain. Downloads the upstream Crossplane CLI
# per platform from releases.crossplane.io and exposes it as a toolchain. Each
# `crossplane.version()` tag in the consumer's MODULE.bazel materializes one
# version's repos.
crossplane = use_extension("//:extensions.bzl", "crossplane")
crossplane.version(version = "v2.2.1")
use_repo(
    crossplane,
    "crank_v2_2_1_linux_amd64",
    "crank_v2_2_1_linux_arm64",
    "crank_v2_2_1_darwin_amd64",
    "crank_v2_2_1_darwin_arm64",
)
register_toolchains("@crank_v2_2_1_linux_amd64//:toolchain")
register_toolchains("@crank_v2_2_1_linux_arm64//:toolchain")
register_toolchains("@crank_v2_2_1_darwin_amd64//:toolchain")
register_toolchains("@crank_v2_2_1_darwin_arm64//:toolchain")

# ---- dev-only: smoke composition --------------------------------------------
bazel_dep(name = "rules_itest", version = "0.0.52", dev_dependency = True)

bazel_dep(name = "rules_kind", version = "0.2.0", dev_dependency = True)
git_override(
    module_name = "rules_kind",
    remote = "https://github.com/collider-bazel-extensions/rules_kind",
    commit = "91ff914ccf55fdd627e7cda3d83d7e4ae8206c14",  # v0.2.0 — k8s 1.35/1.36/1.37, digest-pinned kindest/node images
)

bazel_dep(name = "rules_helm", version = "0.2.1", dev_dependency = True)
git_override(
    module_name = "rules_helm",
    remote = "https://github.com/collider-bazel-extensions/rules_helm",
    commit = "48651387d55f0c50f6d059df246ed73767100afb",  # v0.2.1
)

helm = use_extension("@rules_helm//:extensions.bzl", "helm", dev_dependency = True)
helm.version(version = "3.20.2")
use_repo(
    helm,
    "helm_darwin_amd64",
    "helm_darwin_arm64",
    "helm_linux_amd64",
)
register_toolchains(
    "@helm_linux_amd64//:toolchain",
    "@helm_darwin_amd64//:toolchain",
    "@helm_darwin_arm64//:toolchain",
    dev_dependency = True,
)

crossplane_chart = use_extension("//tools:extensions.bzl", "crossplane_chart", dev_dependency = True)
crossplane_chart.version(version = "2.2.1")
use_repo(crossplane_chart, "crossplane_chart_2_2_1")
