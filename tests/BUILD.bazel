"""Tests for rules_crossplane.

- Analysis tests verify the macros instantiate cleanly.
- Render-test smoke (Primitive 1): runs `crank render` against a
  real Composition + XR + function-patch-and-transform fixture and
  asserts the rendered output contains the expected kinds. Tagged
  `requires-docker` because crank pulls + runs the function image
  via Docker.
- Cluster-install smoke (Primitive 2): kind cluster + Crossplane
  helm chart applied. Smoke verifies core CRDs come up and a
  Composition write+read round-trips through the admission webhook.
"""

load("@rules_crossplane//:defs.bzl", "crossplane_health_check", "crossplane_install", "crossplane_render_test")
load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":analysis_tests.bzl", "crossplane_install_test_suite")

# ---- analysis ---------------------------------------------------------------

crossplane_install_test_suite(name = "crossplane_install_analysis")

# ---- Primitive 1 smoke: crank render ----------------------------------------

crossplane_render_test(
    name = "render_smoke",
    composite = "fixtures/xr.yaml",
    composition = "fixtures/composition.yaml",
    functions = ["fixtures/functions.yaml"],
    expected_kinds = [
        # The XR itself shows up in the rendered output (with its
        # status populated by the Composition).
        "XSmoke",
        # The Composition's pipeline produces a kubernetes.crossplane.io
        # Object that wraps a ConfigMap.
        "Object",
    ],
    tags = [
        "manual",
        # function-patch-and-transform is pulled + run via Docker by
        # crank — needs the host Docker daemon.
        "requires-docker",
        "no-sandbox",
    ],
)

# ---- Primitive 2 smoke: kind + Crossplane install --------------------------

kind_cluster(name = "cluster", k8s_version = "1.35")

kind_health_check(name = "cluster_health", cluster = ":cluster")

itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

crossplane_install(
    name = "crossplane_install_bin",
    tags = ["manual"],
)

crossplane_health_check(
    name = "crossplane_health_bin",
    tags = ["manual"],
)

sh_binary(
    name = "crossplane_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":crossplane_install_bin"],
)

sh_binary(
    name = "crossplane_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":crossplane_health_bin"],
)

itest_service(
    name = "crossplane_svc",
    exe = ":crossplane_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":crossplane_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":crossplane_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)
